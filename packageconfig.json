    "auth_endpoint": {
        "dev": "auth",
        "prod": "auth"
    },
    "auth_template": {
        "type": 0,
        "custom": {
            "register": "",
            "login": ""
        }
    },
    "registration": {
        "enable": 1,
        "default_role_code": "admin",
        "field": ["email","password"]
    },
    "login" :{
        "rememberme": 1,
        "forgotpassword": 1
    },
    "has_auth_grant" : 1,
    "session_lifetime": 60,
    "users_hidden_field": [],
    "user_profiles": {
        "hide_all": 0,
        "hide": [],
        "adds": {}
    },
    "user_form_tab": {
        "profile" : {
            "show":1,
            "caption" : "Profile",
            "component" : "./userform/profile"
        },
        "adds":[]
    },
    "user_profile_tab": {
        "profile" : {
            "show":1,
            "caption" : "Profile",
            "component" : "./userprofile/profile"
        },
        "adds":[]
    },
    "role_hidden_field": [],
    "user_role": {
        "multi_role": 1,
        "user_level": {
            "min":1,
            "max":99
        }
    },
    "notification": {
        "enable":1,
        "show":1,
        "services_enabled": {
            "firebase": 0,
            "pusher": 1,
            "aws_sns": 0
        },
        "use_jobs": 1,
        "channels": {
            "notifAll": {
                "firebase": "notifAll",
                "pusher": "notifAll",
                "aws_sns": "notifAll"
            }
        }
