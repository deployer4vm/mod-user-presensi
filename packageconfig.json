    "package_namespace": "moduser",
    "package_dir": "mod-user",
    "is_package": 1,
    "is_lib": 0,
    "git": "https://gitlab.com/hp-synapse/mod-user.git",
    "has_frontend": 1,
    "has_api": 1,
    "has_admin": 1,
