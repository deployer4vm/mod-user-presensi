                "acl_config": {
                    "show": 1,
                    "crud": {
                        "c": 1,
                        "r": 1,
                        "u": 1,
                        "d": 1
                    }
                }
            },
            "role": {
                "caption": {"en":"Manage Role","id":"Manage Role"},
                "acl_caption": {"en":"Manager User Role Data","id":"Manager User Role Data"},
                "acl_description": {"en":"","id":""},
                "route": { "name": "role.list" },
                "class": "",
                "is_navbar": 1,
                "enable": 1,
                "tenant_group_id": 0,
                "active_acl": {
                    "has_access": 1,
                    "crud": {
                        "c": 1,
                        "r": 1,
                        "u": 1,
                        "d": 1
                    }
                },
                "acl_config": {
                    "show": 1,
                    "crud": {
                        "c": 1,
                        "r": 1,
                        "u": 1,
                        "d": 1
                    }
                }
            },
            "broadcast": {
                "caption": {"en":"Notification Broadcast","id":"Notification Broadcast"},
                "acl_caption": {"en":"Notification Broadcast","id":"Notification Broadcast"},
                "acl_description": {"en":"","id":""},
